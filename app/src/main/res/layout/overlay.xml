<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <View android:id="@+id/scrim" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#99050710" />
    <com.exclusivo.moon.GlowView android:layout_width="match_parent" android:layout_height="280dp" android:layout_gravity="bottom" />
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:layout_margin="12dp"
        android:background="@drawable/sheet_bg" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <com.exclusivo.moon.MoonView android:layout_width="34dp" android:layout_height="34dp" />
            <TextView android:id="@+id/ovTitulo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="10dp" android:text="Escuchando" android:textColor="@color/moon_text" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/chip_bg"
                android:paddingHorizontal="10dp" android:paddingVertical="4dp" android:text="Offline" android:textColor="@color/moon_ok" android:textSize="12sp" />
        </LinearLayout>
        <TextView android:id="@+id/ovTexto" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:minLines="2" android:textColor="@color/moon_text" android:textSize="20sp" />
        <LinearLayout android:id="@+id/ovEscucha" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <com.exclusivo.moon.WaveView android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Toca para detener" android:textColor="@color/moon_muted" android:textSize="13sp" />
                <View android:id="@+id/ovStop" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/stop_btn" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/ovOrden" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/paso1" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="5dp" android:textColor="@color/moon_text" android:textSize="15sp" />
            <TextView android:id="@+id/paso2" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="5dp" android:textColor="@color/moon_text" android:textSize="15sp" />
            <TextView android:id="@+id/paso3" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="5dp" android:textColor="@color/moon_text" android:textSize="15sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Ejecutado con Shizuku, sin root" android:textColor="@color/moon_muted" android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
