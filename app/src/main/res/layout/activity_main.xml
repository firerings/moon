<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/moon_bg" android:fitsSystemWindows="true" android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="20dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Moon" android:textColor="@color/moon_text" android:textSize="26sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvEstado" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/chip_bg" android:paddingHorizontal="14dp" android:paddingVertical="6dp" android:text="Conectando…" android:textColor="@color/moon_muted" android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:id="@+id/vInicio" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_horizontal" android:orientation="vertical" android:padding="20dp">
            <com.exclusivo.moon.MoonView android:layout_width="150dp" android:layout_height="150dp" android:layout_marginTop="24dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="¿En qué te ayudo?" android:textColor="@color/moon_text" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Di «reiniciar» o desliza desde la esquina" android:textColor="@color/moon_muted" android:textSize="14sp" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="130dp" android:layout_marginTop="18dp">
                <View android:id="@+id/pulso" android:layout_width="84dp" android:layout_height="84dp" android:layout_gravity="center" android:alpha="0" android:background="@drawable/pulse_bg" />
                <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/fab" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:src="@drawable/ic_mic" app:backgroundTint="@color/moon_accent" app:fabCustomSize="76dp" app:maxImageSize="32dp" />
            </FrameLayout>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:id="@+id/chipVoz" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/chip_bg" android:paddingHorizontal="14dp" android:paddingVertical="6dp" android:text="Voz" android:textColor="@color/moon_muted" android:textSize="13sp" />
                <TextView android:id="@+id/chipAsis" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:background="@drawable/chip_bg" android:paddingHorizontal="14dp" android:paddingVertical="6dp" android:text="Asistente" android:textColor="@color/moon_muted" android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/vActividad" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Transcripciones de esta sesión" android:textColor="@color/moon_muted" android:textSize="13sp" />
                <TextView android:id="@+id/btnLimpiar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="4dp" android:text="Limpiar" android:textColor="@color/moon_accent" android:textSize="13sp" />
            </LinearLayout>
            <ScrollView android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="12dp" android:layout_weight="1">
                <TextView android:id="@+id/tvHist" android:layout_width="match_parent" android:layout_height="wrap_content" android:lineSpacingExtra="4dp" android:textColor="@color/moon_text" android:textSize="17sp" />
            </ScrollView>
        </LinearLayout>

        <ScrollView android:id="@+id/vSistema" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/card_bg" android:orientation="vertical" android:padding="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Asistente predeterminado" android:textColor="@color/moon_text" android:textSize="15sp" />
                        <TextView android:id="@+id/stAsis" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/chip_bg" android:paddingHorizontal="12dp" android:paddingVertical="5dp" android:textColor="@color/moon_muted" android:textSize="12sp" />
                    </LinearLayout>
                    <TextView android:id="@+id/btnAsis" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingVertical="10dp" android:text="Abrir ajustes del asistente" android:textColor="@color/moon_accent" android:textSize="14sp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Servidor de voz" android:textColor="@color/moon_text" android:textSize="15sp" />
                        <TextView android:id="@+id/stVoz" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/chip_bg" android:paddingHorizontal="12dp" android:paddingVertical="5dp" android:textColor="@color/moon_muted" android:textSize="12sp" />
                    </LinearLayout>
                    <EditText android:id="@+id/etToken" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Token que imprime voz_servidor.py" android:inputType="textNoSuggestions" android:singleLine="true" android:textColor="@color/moon_text" android:textColorHint="@color/moon_muted" android:textSize="14sp" />
                    <TextView android:id="@+id/btnToken" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingVertical="10dp" android:text="Guardar token" android:textColor="@color/moon_accent" android:textSize="14sp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/card_bg" android:orientation="vertical" android:padding="16dp">
                    <TextView android:id="@+id/tvVersion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/moon_text" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:id="@+id/btnUpd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingTop="8dp" android:text="Buscar actualización" android:textColor="@color/moon_accent" android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/moon_card">
        <TextView android:id="@+id/tab0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:paddingVertical="16dp" android:text="Inicio" android:textSize="14sp" />
        <TextView android:id="@+id/tab1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:paddingVertical="16dp" android:text="Actividad" android:textSize="14sp" />
        <TextView android:id="@+id/tab2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:paddingVertical="16dp" android:text="Sistema" android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
